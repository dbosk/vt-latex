% === provenance: Knauff2014Latex ===
% CLAIM: In a controlled comparison, LaTeX users were slower and produced more
%   formatting, orthographical and grammatical errors than Word users on
%   continuous and tabular text (experts included), yet LaTeX users reported
%   enjoying their tool more.
% FOUND-VIA: scholar search "latex word document preparation comparison" -p s2 -p openalex
% PICKED: the only controlled efficiency study of LaTeX vs word processors
%   (n=40, PLOS ONE, open access); widely discussed, so cite with its scope
%   limits (text-typing tasks; equations were LaTeX's strong case).
% QUOTE (abstract): "LaTeX users were slower than Word users, wrote less text
%   in the same amount of time, and produced more typesetting, orthographical,
%   grammatical, and formatting errors. [...] LaTeX users, however, more often
%   report enjoying using their respective software."
% VERIFIED: abstract read (OpenAlex); OA full text at PLOS. Note the study is
%   about professionals/academics, not students, and the equation condition
%   favored LaTeX -- do not over-claim.
% DATE: 2026-07-18
@article{Knauff2014Latex,
  title={An Efficiency Comparison of Document Preparation Systems Used in Academic Research and Development},
  author={Knauff, Markus and Nejasmic, Jelica},
  journal={PLoS ONE},
  volume={9},
  number={12},
  pages={e115069},
  year={2014},
  doi={10.1371/journal.pone.0115069},
}

% === provenance: DuBoulay1981BlackBox ===
% CLAIM: Origin of the "notional machine": novices should be shown a
%   conceptually simple, observable model of the machine (the "glass box")
%   rather than an opaque black box.
% FOUND-VIA: scholar search "black box inside glass box presenting computing concepts" -p openalex -p dblp
% PICKED: the primary/origin source for the notional-machine idea (1981;
%   IJHCS reprint 1999).
% QUOTE: TODO -- full text not accessible this session (figshare record holds
%   metadata only; publisher paywalled).
% VERIFIED: TODO -- attribution cross-checked only indirectly: Sorva (2013,
%   verified abstract) reviews the literature "in relation to the concept of a
%   'notional machine'---an abstract computer for executing programs of a
%   particular kind" and the term is standardly attributed to this paper.
%   Read the full text before quoting specifics.
% DATE: 2026-07-18
@article{DuBoulay1981BlackBox,
  title={The black box inside the glass box: presenting computing concepts to novices},
  author={du Boulay, Benedict and O'Shea, Tim and Monk, John},
  journal={International Journal of Man-Machine Studies},
  volume={14},
  number={3},
  pages={237--249},
  year={1981},
  note={Reprinted in Int. J. Human-Computer Studies 51(2):265--277, 1999},
  doi={10.1006/ijhc.1981.0309},
}

