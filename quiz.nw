    "interaction_type_slug": "choice",
    "interaction_data": {
      "choices": [
        {"position": 1, "item_body": "<p>Fix the first error (\\includegraphics is undefined&mdash;the graphicx package is missing) and compile again, since later errors are often caused by it</p>"},
        {"position": 2, "item_body": "<p>Fix the last of the eight errors first, since it is the most recent</p>"},
        {"position": 3, "item_body": "<p>Fix all eight errors before compiling again</p>"},
        {"position": 4, "item_body": "<p>The eight errors are unrelated; fix whichever looks easiest</p>"}
      ]
